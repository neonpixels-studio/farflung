{
  "name": "farflung",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "TMPDIR=/tmp dotenvx run -f .env -- nuxt dev",
    "dev:test": "TMPDIR=/tmp nuxt dev",
    "build": "dotenvx run -f .env.production -- nuxt build",
    "build:dev": "dotenvx run -f .env.dev -- nuxt build",
    "preview": "dotenvx run -f .env.production -- nuxt preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run",
    "test:types": "vitest --typecheck",
    "lint": "prettier --check . && eslint . && fallow audit",
    "lint:ci": "prettier --check . && eslint . && fallow audit --base origin/${BASE_BRANCH:-main}",
    "lint:fix": "prettier --write . && eslint . --fix && fallow fix --yes",
    "prepare": "husky",
    "db:generate": "dotenvx run -f .env -- drizzle-kit generate",
    "db:migrate": "dotenvx run -f .env -- drizzle-kit migrate",
    "db:migrate:production": "dotenvx run -f .env.production -- drizzle-kit migrate",
    "db:push": "dotenvx run -f .env -- drizzle-kit push",
    "db:studio": "dotenvx run -f .env -- drizzle-kit studio",
    "e2e": "dotenvx run -f .env.e2e -- playwright test",
    "e2e:headed": "dotenvx run -f .env.e2e -- playwright test --headed",
    "e2e:ui": "dotenvx run -f .env.e2e -- playwright test --ui",
    "e2e:debug": "dotenvx run -f .env.e2e -- playwright test --debug",
    "e2e:report": "playwright show-report e2e/report"
  },
  "overrides": {
    "minimatch": "^10.2.5",
    "h3": "^1.15.11",
    "brace-expansion": "^5.0.12",
    "tar": "^7.5.21",
    "shell-quote": "^1.9.0",
    "svgo": "^4.1.0",
    "nanoid": "^3.3.17",
    "undici": "^8.11.2"
  },
  "dependencies": {
    "@clerk/backend": "^3.21.1",
    "@clerk/nuxt": "^3.1.8",
    "@neondatabase/serverless": "^1.2.0",
    "@netlify/blobs": "^11.1.3",
    "@pinia/nuxt": "^1.0.2",
    "@sentry/nuxt": "^11.2.0",
    "@types/mapbox-gl": "^3.5.0",
    "@vue/devtools-api": "^8.2.1",
    "drizzle-orm": "^0.45.3",
    "mapbox-gl": "^3.32.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.2",
    "radix3": "^1.1.2",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "svix": "^2.6.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.41",
    "@dotenvx/dotenvx": "^2.32.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/ui": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fallow": "^3.31.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
